{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToolManifest",
  "type": "object",
  "required": ["id", "name", "category", "version"],
  "properties": {
    "id": { "type": "string" },
    "uuid": { "type": "string" },
    "name": { "type": "string" },
    "slug": { "type": "string" },
    "shortName": { "type": "string" },
    "category": { "type": "string" },
    "subcategory": { "type": "string" },
    "version": { "type": "string" },
    "status": { "type": "string" },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "shortDescription": { "type": "string" },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "searchSynonyms": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "capabilities": {
      "type": "object",
      "properties": {
        "dragDrop": { "type": "boolean" },
        "clipboard": { "type": "boolean" },
        "download": { "type": "boolean" },
        "share": { "type": "boolean" },
        "offline": { "type": "boolean" },
        "batch": { "type": "boolean" },
        "print": { "type": "boolean" },
        "fullscreen": { "type": "boolean" }
      }
    },
    "seo": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "keywords": { "type": "string" },
        "canonicalUrl": { "type": "string" }
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["q", "a"],
        "properties": {
          "q": { "type": "string" },
          "a": { "type": "string" }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "input": { "type": "string" },
          "output": { "type": "string" }
        }
      }
    }
  }
}
